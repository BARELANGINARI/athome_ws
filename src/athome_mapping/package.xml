<?xml version="1.0"?>
<package format="3">
  <name>athome_mapping</name>
  <version>0.1.0</version>
  <description>2D SLAM mapping package for Barelang Inari robot using slam_toolbox.</description>
  <maintainer email="barelang.inari@gmail.com">Barelang Inari Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>athome_base</exec_depend>
  <exec_depend>athome_bringup</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

