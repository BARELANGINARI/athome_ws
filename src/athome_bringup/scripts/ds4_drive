#!/usr/bin/env python3
"""DS4 drive: stick kiri gerak, L1 turbo, segitiga cruise maju -> cmd_vel.

Menggantikan teleop_twist_joy (tidak bisa mapping tombol->maju).
Layout DualShock 4 kernel: 8 axes, 13 tombol.
  axes: 0=LX 1=LY 2=L2 3=RX 4=RY 5=R2 6=DPAD-X 7=DPAD-Y
  buttons: 0=X 1=O 2=Segitiga 3=Kotak 4=L1 5=R1 6=L2 7=R2
           8=Share 9=Options 10=PS 11=L3 12=R3
"""

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, DurabilityPolicy, HistoryPolicy
from sensor_msgs.msg import Joy
from geometry_msgs.msg import Twist

AX_LX, AX_LY, AX_RX = 0, 1, 3
BTN_TURBO, BTN_CRUISE = 4, 2  # L1, Segitiga


class Ds4Drive(Node):
    def __init__(self):
        super().__init__('ds4_drive')
        self.declare_parameter('deadzone', 0.08)
        self.declare_parameter('normal_linear', 0.30)
        self.declare_parameter('max_linear', 0.50)
        self.declare_parameter('normal_angular', 1.0)
        self.declare_parameter('max_angular', 1.5)
        self.deadzone = float(self.get_parameter('deadzone').value)
        self.normal_linear = float(self.get_parameter('normal_linear').value)
        self.max_linear = float(self.get_parameter('max_linear').value)
        self.normal_angular = float(self.get_parameter('normal_angular').value)
        self.max_angular = float(self.get_parameter('max_angular').value)
        self.declare_parameter('joy_timeout', 0.2)
        self.joy_timeout = float(self.get_parameter('joy_timeout').value)
        # QoS BestEffort + KeepLast(1) supaya cocok dengan nucleo
        # (publisher Reliable + queue 10 bikin antre/retransmit = delay).
        qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=1,
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE,
        )
        self.pub = self.create_publisher(Twist, 'cmd_vel', qos)
        self.sub = self.create_subscription(Joy, 'joy', self.on_joy, qos)
        self._last_joy_time = self.get_clock().now()
        self._stopped = False
        # Safety: kalau joy putus (bluetooth drop), kirim 0 secepatnya
        # daripada nunggu cmd_vel_timeout 0.5 s di nucleo.
        self._timer = self.create_timer(0.05, self._check_timeout)
        self.get_logger().info(
            'DS4 siap: stick kiri gerak, L1=cepat, segitiga=maju lurus')

    @staticmethod
    def _dz(v, width):
        return 0.0 if abs(v) < width else v

    def on_joy(self, msg):
        self._last_joy_time = self.get_clock().now()
        self._stopped = False
        ax = msg.axes
        bt = msg.buttons
        lx = self._dz(ax[AX_LX], self.deadzone) if len(ax) > AX_LX else 0.0
        ly = self._dz(ax[AX_LY], self.deadzone) if len(ax) > AX_LY else 0.0
        rx = self._dz(ax[AX_RX], self.deadzone) if len(ax) > AX_RX else 0.0
        turbo = len(bt) > BTN_TURBO and bt[BTN_TURBO] == 1
        cruise = len(bt) > BTN_CRUISE and bt[BTN_CRUISE] == 1

        lin = self.max_linear if turbo else self.normal_linear
        ang = self.max_angular if turbo else self.normal_angular

        vx = ly * lin
        if cruise:
            vx = lin  # segitiga: maju lurus (vy/yaw dari stick tetap aktif)
        vy = lx * lin
        yaw = rx * ang

        vx = max(-self.max_linear, min(self.max_linear, vx))
        vy = max(-self.max_linear, min(self.max_linear, vy))
        yaw = max(-self.max_angular, min(self.max_angular, yaw))

        twist = Twist()
        twist.linear.x = vx
        twist.linear.y = vy
        twist.angular.z = yaw
        self.pub.publish(twist)

    def _check_timeout(self):
        if self._stopped:
            return
        age = (self.get_clock().now() - self._last_joy_time).nanoseconds * 1e-9
        if age > self.joy_timeout:
            self.pub.publish(Twist())  # semua nol = stop
            self._stopped = True


def main():
    rclpy.init()
    node = Ds4Drive()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
