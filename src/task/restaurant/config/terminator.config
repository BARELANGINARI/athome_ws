[global_config]
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
  [[restaurant]]
    [[[window0]]]
      type = Window
      parent = ""
      title = Restaurant Task (6-Pane Grid)
    [[[paned0]]]
      type = VPaned
      parent = window0
      ratio = 0.5
    [[[paned_top]]]
      type = HPaned
      parent = paned0
      order = 0
      ratio = 0.33
    [[[terminal_hw]]]
      type = Terminal
      parent = paned_top
      order = 0
      title = Hardware (STM32 & RPLiDAR)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && ros2 launch restaurant hardware.launch.py; exec bash
    [[[paned_top_right]]]
      type = HPaned
      parent = paned_top
      order = 1
      ratio = 0.5
    [[[terminal_nav]]]
      type = Terminal
      parent = paned_top_right
      order = 0
      title = Navigation (Nav2 SLAM & Restaurant Node)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 2 && ros2 launch restaurant motion.launch.py; exec bash
    [[[terminal_face]]]
      type = Terminal
      parent = paned_top_right
      order = 1
      title = Face (athome_face_display)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 3 && ros2 launch athome_face_display face.launch.py; exec bash
    [[[paned_bottom]]]
      type = HPaned
      parent = paned0
      order = 1
      ratio = 0.33
    [[[terminal_cam]]]
      type = Terminal
      parent = paned_bottom
      order = 0
      title = Camera (ZED Vision & Gesture/Face)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 3 && ros2 launch restaurant camera.launch.py; exec bash
    [[[paned_bottom_right]]]
      type = HPaned
      parent = paned_bottom
      order = 1
      ratio = 0.5
    [[[terminal_hri]]]
      type = Terminal
      parent = paned_bottom_right
      order = 0
      title = HRI & Manager (Whisper & Piper & Restaurant Manager)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 4 && ros2 launch restaurant hri.launch.py; exec bash
    [[[terminal_arm]]]
      type = Terminal
      parent = paned_bottom_right
      order = 1
      title = Arm (Dynamixel Arm Motion Server)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 5 && ros2 launch athome_arm arm.launch.py task:=restaurant; exec bash
[plugins]
