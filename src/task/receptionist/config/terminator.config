[global_config]
  title_transmit_fg_color = "#ffffff"
  title_transmit_bg_color = "#1a73e8"
  title_inactive_fg_color = "#cccccc"
  title_inactive_bg_color = "#333333"
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
  [[receptionist]]
    [[[window0]]]
      type = Window
      parent = ""
      title = "Receptionist (2x2 Grid)"
    [[[paned0]]]
      type = VPaned
      parent = window0
      ratio = 0.5
    [[[paned_top]]]
      type = HPaned
      parent = paned0
      order = 0
      ratio = 0.5
    [[[paned_bottom]]]
      type = HPaned
      parent = paned0
      order = 1
      ratio = 0.5
    [[[terminal_hw]]]
      type = Terminal
      parent = paned_top
      order = 0
      title = "Hardware (STM32 & RPLiDAR)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && ros2 launch receptionist hardware.launch.py; exec bash
    [[[terminal_nav]]]
      type = Terminal
      parent = paned_top
      order = 1
      title = "Navigation (Nav2 & RViz)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 2 && ros2 launch receptionist motion.launch.py; exec bash
    [[[terminal_cam]]]
      type = Terminal
      parent = paned_bottom
      order = 0
      title = "Camera (Vision & IMU)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 3 && ros2 launch receptionist camera.launch.py; exec bash
    [[[terminal_hri]]]
      type = Terminal
      parent = paned_bottom
      order = 1
      title = "HRI (Whisper & Piper)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 4 && ros2 launch receptionist hri.launch.py; exec bash
[plugins]
