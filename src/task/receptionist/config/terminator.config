[global_config]
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
  [[receptionist]]
    [[[window0]]]
      type = Window
      parent = ""
      title = Receptionist (5-Pane Grid)
    [[[paned0]]]
      type = VPaned
      parent = window0
      ratio = 0.5
    [[[paned_top]]]
      type = HPaned
      parent = paned0
      order = 0
      ratio = 0.5
    [[[terminal_hw]]]
      type = Terminal
      parent = paned_top
      order = 0
      title = Hardware (STM32 & RPLiDAR)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && ros2 launch receptionist hardware.launch.py; exec bash
    [[[terminal_nav]]]
      type = Terminal
      parent = paned_top
      order = 1
      title = Navigation (Nav2 & RViz)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 2 && ros2 launch receptionist motion.launch.py; exec bash
    [[[paned_bottom]]]
      type = HPaned
      parent = paned0
      order = 1
      ratio = 0.33
    [[[terminal_cam]]]
      type = Terminal
      parent = paned_bottom
      order = 0
      title = Camera (Vision & IMU)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 3 && ros2 launch receptionist camera.launch.py; exec bash
    [[[paned_bottom_right]]]
      type = HPaned
      parent = paned_bottom
      order = 1
      ratio = 0.5
    [[[terminal_hri]]]
      type = Terminal
      parent = paned_bottom_right
      order = 0
      title = HRI (Whisper & Piper)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 4 && ros2 launch receptionist hri.launch.py; exec bash
    [[[terminal_arm]]]
      type = Terminal
      parent = paned_bottom_right
      order = 1
      title = Arm (Dynamixel Arm Motion Server)
      command = cd "${WS_DIR:-/home/cyan/Documents/athome-ws}" && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 5 && ros2 launch athome_arm arm.launch.py task:=receptionist; exec bash
[plugins]
