[global_config]
  title_transmit_fg_color = "#ffffff"
  title_transmit_bg_color = "#1a73e8"
  title_inactive_fg_color = "#cccccc"
  title_inactive_bg_color = "#333333"
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
  [[help_me_carry]]
    [[[window0]]]
      type = Window
      parent = ""
      title = "Help Me Carry (5-Pane Grid)"
    [[[paned0]]]
      type = VPaned
      parent = window0
      ratio = 0.5
    [[[paned_top]]]
      type = HPaned
      parent = paned0
      order = 0
      ratio = 0.5
    [[[terminal_hw]]]
      type = Terminal
      parent = paned_top
      order = 0
      title = "Hardware (STM32 & RPLiDAR)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && ros2 launch help_me_carry hardware.launch.py; exec bash
    [[[terminal_motion]]]
      type = Terminal
      parent = paned_top
      order = 1
      title = "Motion (SLAM, Nav2, Follower & RViz)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 2 && ros2 launch help_me_carry motion.launch.py; exec bash
    [[[paned_bottom]]]
      type = HPaned
      parent = paned0
      order = 1
      ratio = 0.33
    [[[terminal_cam]]]
      type = Terminal
      parent = paned_bottom
      order = 0
      title = "Camera (ZED Vision & IMU)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 3 && ros2 launch help_me_carry camera.launch.py; exec bash
    [[[paned_bottom_right]]]
      type = HPaned
      parent = paned_bottom
      order = 1
      ratio = 0.5
    [[[terminal_hri]]]
      type = Terminal
      parent = paned_bottom_right
      order = 0
      title = "HRI (Speech & Web Dashboard)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 4 && ros2 launch help_me_carry hri.launch.py; exec bash
    [[[terminal_arm]]]
      type = Terminal
      parent = paned_bottom_right
      order = 1
      title = "Arm (Dynamixel Arm Motion Server)"
      command = cd /home/cyan/Documents/athome-ws && source /opt/ros/jazzy/setup.bash && source install/setup.bash && sleep 5 && ros2 launch athome_arm arm.launch.py; exec bash
[plugins]
