#!/usr/bin/env python3
"""Analisis kinematik nucleo dari rosbag: /odom + /cmd_vel -> CSV + PNG + statistik.

Pakai:
    ros2 bag record -o jalan1 /odom /cmd_vel
    ros2 run robot_bringup bag_kinematics jalan1

Hasil: jalan1_odom.csv, jalan1_cmd.csv, jalan1_trajectory.png,
       jalan1_tracking.png + ringkasan di terminal.
Satuan: posisi meter, yaw radian, twist m/s & rad/s (lihat Kinematic.hpp).
"""

import csv
import math
import os
import sys

import matplotlib

matplotlib.use('Agg')
import matplotlib.pyplot as plt

from rclpy.serialization import deserialize_message
from rosbag2_py import ConverterOptions, SequentialReader, StorageOptions
from nav_msgs.msg import Odometry
from geometry_msgs.msg import Twist


def yaw_from_quat(q):
    return 2.0 * math.atan2(q.z, q.w)


def read_bag(bag_path):
    reader = SequentialReader()
    reader.open(StorageOptions(uri=bag_path, storage_id='sqlite3'),
                ConverterOptions('', ''))
    odom, cmd = [], []
    t0 = None
    while reader.has_next():
        topic, data, stamp = reader.read_next()
        if t0 is None:
            t0 = stamp
        t = (stamp - t0) * 1e-9
        if topic == '/odom':
            m = deserialize_message(data, Odometry)
            odom.append((t, m.pose.pose.position.x, m.pose.pose.position.y,
                         yaw_from_quat(m.pose.pose.orientation),
                         m.twist.twist.linear.x, m.twist.twist.linear.y,
                         m.twist.twist.angular.z))
        elif topic == '/cmd_vel':
            m = deserialize_message(data, Twist)
            cmd.append((t, m.linear.x, m.linear.y, m.angular.z))
    return odom, cmd


def write_csv(path, header, rows):
    with open(path, 'w', newline='') as f:
        csv.writer(f).writerow(header)
        csv.writer(f).writerows(rows)


def main():
    if len(sys.argv) < 2:
        print('pakai: bag_kinematics <folder_bag>')
        return 1
    bag = sys.argv[1].rstrip('/')
    base = os.path.basename(bag)
    outdir = os.path.dirname(os.path.abspath(bag))
    odom, cmd = read_bag(bag)
    if not odom:
        print('tidak ada /odom di bag ini')
        return 1
    print(f'/odom: {len(odom)} pesan, /cmd_vel: {len(cmd)} pesan, '
          f'durasi {odom[-1][0]:.1f} s')

    write_csv(os.path.join(outdir, base + '_odom.csv'),
              ['t', 'x', 'y', 'yaw', 'vx', 'vy', 'wz'], odom)
    if cmd:
        write_csv(os.path.join(outdir, base + '_cmd.csv'),
                  ['t', 'vx', 'vy', 'wz'], cmd)

    dist = sum(math.hypot(odom[i][1] - odom[i - 1][1],
                          odom[i][2] - odom[i - 1][2])
               for i in range(1, len(odom)))
    vmax = max(math.hypot(r[4], r[5]) for r in odom)
    wmax = max(abs(r[6]) for r in odom)
    print(f'jarak tempuh odom: {dist:.2f} m, |v| maks: {vmax:.2f} m/s, '
          f'|w| maks: {wmax:.2f} rad/s')
    print(f'posisi akhir: x={odom[-1][1]:.2f} y={odom[-1][2]:.2f} '
          f'yaw={odom[-1][3]:.2f} rad')

    t = [r[0] for r in odom]
    plt.figure()
    plt.plot([r[1] for r in odom], [r[2] for r in odom])
    plt.axis('equal')
    plt.xlabel('x [m]')
    plt.ylabel('y [m]')
    plt.title('Trajektori odom nucleo')
    plt.savefig(os.path.join(outdir, base + '_trajectory.png'), dpi=100)

    if cmd:
        tc = [r[0] for r in cmd]
        _, ax = plt.subplots(2, 1, figsize=(8, 6), sharex=True)
        ax[0].plot(tc, [r[1] for r in cmd], label='cmd vx')
        ax[0].plot(t, [r[4] for r in odom], label='odom vx')
        ax[0].set_ylabel('m/s')
        ax[0].legend()
        ax[1].plot(tc, [r[3] for r in cmd], label='cmd wz')
        ax[1].plot(t, [r[6] for r in odom], label='odom wz')
        ax[1].set_ylabel('rad/s')
        ax[1].set_xlabel('t [s]')
        ax[1].legend()
        plt.tight_layout()
        plt.savefig(os.path.join(outdir, base + '_tracking.png'), dpi=100)
    print('hasil tersimpan di', outdir)
    return 0


if __name__ == '__main__':
    sys.exit(main())
