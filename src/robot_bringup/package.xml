<?xml version="1.0"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Bringup: nucleo + zed yaw + lidar sensors.</description>
  <maintainer email="ichsan@gmail.com">robot_ws</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>nucleo</exec_depend>
  <!-- zed hanya runtime (sensors.launch.py include zed.launch.py), dibangun di MiniPC -->
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
